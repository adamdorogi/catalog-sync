{
  "name": "catalog-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "18.x"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run --threads=false",
    "typecheck": "tsc --noEmit",
    "dev:api": "npm run dev -w @catalog-sync/api",
    "dev:worker": "npm run dev -w @catalog-sync/worker",
    "seed": "tsx scripts/seed-catalog.ts",
    "simulate:load": "tsx scripts/simulate-load.ts"
  },
  "devDependencies": {
    "@types/node": "18.15.11",
    "@types/pg": "8.6.6",
    "tsx": "3.12.6",
    "typescript": "~4.9.5",
    "vitest": "0.29.2",
    "@types/cors": "2.8.13",
    "@types/express": "4.17.17",
    "@types/multer": "1.4.7"
  }
}
